# Tiger Cloud: copy the connection string from your service's "Connect" page.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/receipts

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any current Gemini model id works; the alias tracks the latest Flash model.
GEMINI_MODEL=gemini-flash-latest

# Optional
SENTRY_DSN=
APP_PASSWORD=
TIMEZONE=America/New_York
